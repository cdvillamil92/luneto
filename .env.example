# ── Luneto — Variables de entorno (ejemplo) ──────────────────────────────
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env con secretos reales al repositorio.

# Entorno de ejecución
NODE_ENV=development

# URL pública del sitio
NEXT_PUBLIC_SERVER_URL=https://luneto.ddev.site

# Payload
PAYLOAD_SECRET=reemplaza-con-un-secreto-largo-y-aleatorio
PAYLOAD_PUBLIC_SERVER_URL=https://luneto.ddev.site

# Base de datos PostgreSQL
DATABASE_URI=postgres://db:db@db:5432/db

# Almacenamiento S3 (compatible con S3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# WhatsApp (se configura desde el admin, esto es solo respaldo)
NEXT_PUBLIC_WHATSAPP_NUMBER=
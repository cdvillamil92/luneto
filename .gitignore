# =============================================================================
# LARAVEL CORE & DEPENDENCIES
# =============================================================================
/node_modules
/vendor
#/public/build
/public/hot
/public/storage
/storage/*.key
.env
.env.backup
.env.production
.env.local
.env.testing

# =============================================================================
# DATABASES, BACKUPS & COMPRESSED FILES
# =============================================================================
# Base de datos y volcados de datos
*.sql
*.sqlite
*.sqlite3
*.db
*.dump

# Archivos comprimidos y empaquetados (Backups, logs viejos, etc.)
*.gz
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# Directorios comunes de backups en Laravel y DDEV
/storage/db_backups/
/.ddev/db-snapshots/

# =============================================================================
# DDEV DEVELOPMENT ENVIRONMENT
# =============================================================================
/.ddev/
!/.ddev/config.yaml
!/.ddev/README.md

# =============================================================================
# LOGS, CACHES & TESTING
# =============================================================================
/storage/logs/*
!/storage/logs/.gitignore
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
chatter.log
npm-debug.log
yarn-error.log
.pnpm-debug.log

# =============================================================================
# IDEs, EDITORS & OS FILES
# =============================================================================
# macOS / Windows
.DS_Store
Thumbs.db
Desktop.ini

# VS Code / PhpStorm / Sublime
/.idea/
/.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.buildpath
.settings/
